APP_NAME="Halowatt Admin"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Tashkent
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=error

# BOT bilan BIR XIL PostgreSQL baza
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=halowatt
DB_USERNAME=halowatt
DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Node botning ichki API manzili + maxfiy kalit (bot .env bilan bir xil)
BOT_API_URL=http://127.0.0.1:4000
BOT_API_SECRET=change-this-secret
