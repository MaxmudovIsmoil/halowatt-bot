# Telegram bot tokeni (@BotFather dan olinadi)
TELEGRAM_BOT_TOKEN=123456:ABC-YOUR-TOKEN

# PostgreSQL (Laravel admin bilan BIR XIL baza)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=halowatt
DB_USER=halowatt
DB_PASSWORD=secret

# Claude AI kaliti (source_mode = ai yoki both bo'lganda ishlatiladi)
# https://console.anthropic.com dan olinadi
ANTHROPIC_API_KEY=sk-ant-xxxx
ANTHROPIC_MODEL=claude-sonnet-4-5

# Ichki API port (Laravel admin "hozir yubor" tugmasi shu portga so'rov yuboradi)
BOT_API_PORT=4000
# Laravel bilan bir xil bo'lishi kerak bo'lgan maxfiy kalit
INTERNAL_API_SECRET=change-this-secret
